{
  "name": "pedaler-en-auvergne",
  "version": "0.3.0",
  "private": true,
  "description": "Portail des acteurs du vélo du Puy-de-Dôme, extensible à l'Auvergne",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "astro sync && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && node scripts/garde-commit.ts marquer",
    "test:e2e": "playwright test",
    "lighthouse": "astro build && lhci autorun",
    "import:osm": "tsx scripts/import-osm.ts",
    "trace:osm": "tsx scripts/trace-osm.ts",
    "icones": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "astro": "7.3.8",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vite-pwa/astro": "1.2.0",
    "@vitest/coverage-v8": "5.0.4",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "semver": "7.8.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.4",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  }
}
