---
import { LONGUEUR_ANNEAU, texteAnneau } from '@lib/tampon';

interface Props {
  /** Identifiant unique dans la page, pour le tracé circulaire du texte. */
  id: string;
  /** Texte gravé sur l'anneau, par exemple « Membre ★ Usagers » ; répété s'il est court. */
  texte: string;
  /** Texte au centre (numéro de département…) ; à défaut, le profil des Puys. */
  centre?: string;
  /** Nom accessible du tampon, lu à la place du texte gravé. */
  libelle: string;
}

const { id, texte, centre, libelle } = Astro.props;
const anneau = texteAnneau(texte);
const cercle = `${id}-cercle`;
const interieur = `${id}-interieur`;
---

<svg class="tampon" viewBox="0 0 100 100" width="88" height="88" role="img" aria-label={libelle}>
  <defs>
    <path id={cercle} d="M50 50m-37 0a37 37 0 1 1 74 0a37 37 0 1 1-74 0"></path>
    <clipPath id={interieur}>
      <circle cx="50" cy="50" r="27.5"></circle>
    </clipPath>
  </defs>
  <circle class="tampon__anneau" cx="50" cy="50" r="46" stroke-width="3"></circle>
  <circle class="tampon__anneau" cx="50" cy="50" r="29" stroke-width="1.6"></circle>
  <text class="tampon__texte" font-size={anneau.taille}>
    <textPath href={`#${cercle}`} textLength={LONGUEUR_ANNEAU} lengthAdjust="spacing">
      {anneau.texte}
    </textPath>
  </text>
  {centre ? (
    <text class="tampon__texte" x="50" y="57" text-anchor="middle" font-size="20">
      {centre}
    </text>
  ) : (
    <g clip-path={`url(#${interieur})`}>
      <path
        class="tampon__relief"
        d="M21 60 30 57c4-9 6-15 10-16l3 3 3-3c3.5 2 6 8 9 13 3-3.5 5-5 8-4 3 1 4 3.5 6 5l6 5V80H21Z"
      ></path>
      <circle class="tampon__cycliste" cx="36" cy="48" r="3.2"></circle>
    </g>
  )}
</svg>

<style>
  /* Tampon de cyclotourisme : déclinaisons « Pédaler à… » et badge « membre » (ADR 0024). */
  .tampon {
    flex: none;
    color: var(--couleur-action);
    transform: rotate(8deg);
  }

  .tampon__anneau {
    fill: none;
    stroke: currentColor;
  }

  .tampon__texte {
    fill: currentColor;
    font-family: var(--police-titres);
    font-weight: 800;
  }

  .tampon__relief {
    fill: currentColor;
    opacity: 0.85;
  }

  .tampon__cycliste {
    fill: var(--couleur-genet);
    stroke: currentColor;
    stroke-width: 1.4;
  }
</style>
