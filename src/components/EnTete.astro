---
import Icone from '@components/Icone.astro';
import Logo from '@components/Logo.astro';
import { ORGANISATEUR } from '@config/organisateur';
import { RUBRIQUES } from '@config/rubriques';

interface Props {
  /** Chemin de la page courante, pour signaler l'entrée active du menu. */
  chemin: string;
}

const { chemin } = Astro.props;

/** Chaque rubrique porte sa couleur (ADR 0039) ; « À propos » reste neutre. */
const entrees = [
  ...RUBRIQUES.map(({ cle, href, libelle }) => ({ href, libelle, icone: cle, rubrique: cle })),
  { href: '/a-propos/', libelle: 'À propos', icone: 'a-propos', rubrique: undefined },
] as const;

const estActive = (href: string) => chemin.startsWith(href);
---

<header class="en-tete">
  <div class="conteneur en-tete__interieur">
    <a class="marque" href="/">
      <Logo />
    </a>
    <nav aria-label="Navigation principale">
      <ul class="menu">
        {entrees.map(({ href, libelle, icone, rubrique }) => (
          <li class:list={[rubrique && `rubrique-${rubrique}`, { menu__neutre: !rubrique }]}>
            <a href={href} aria-current={estActive(href) ? 'page' : undefined}>
              <Icone nom={icone} />
              {libelle}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      class="compte"
      href={ORGANISATEUR.pages.tableauDeBord}
      aria-current={estActive(ORGANISATEUR.racine) ? 'page' : undefined}
    >
      <Icone nom="compte" />
      Mon compte
    </a>
  </div>
</header>

<style>
  .en-tete {
    border-block-end: 1px solid var(--couleur-bordure);
    background: var(--couleur-surface);
    color: var(--couleur-texte);
  }

  .en-tete__interieur {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-2) var(--espace-4);
    padding-block: var(--espace-2);
  }

  .marque {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--cible-tactile);
    color: var(--couleur-texte);
    text-decoration: none;
  }

  /* Accès à l'espace organisateur, à part du menu : en haut à droite, même sur mobile. */
  .compte {
    display: flex;
    align-items: center;
    gap: var(--espace-1);
    min-height: var(--cible-tactile);
    padding-inline: var(--espace-3);
    border: 1px solid var(--couleur-bordure);
    border-radius: 999px;
    color: var(--couleur-texte);
    font-weight: 600;
    text-decoration: none;
  }

  .compte:hover,
  .compte[aria-current='page'] {
    border-color: currentColor;
    color: var(--couleur-primaire);
  }

  .menu {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu a {
    display: flex;
    align-items: center;
    color: var(--couleur-texte);
    font-weight: 600;
    text-decoration: none;
  }

  /* Pictogramme toujours à la couleur de sa rubrique ; l'entrée active en prend le fond pâle. */
  .menu__neutre {
    --couleur-rubrique: var(--couleur-primaire);
    --couleur-rubrique-pale: var(--couleur-prairie-pale);
  }

  .menu :global(.icone) {
    color: var(--couleur-rubrique);
  }

  .menu a:hover,
  .menu a[aria-current='page'] {
    color: var(--couleur-rubrique);
  }

  .menu a[aria-current='page'] {
    background: var(--couleur-rubrique-pale);
  }

  /*
   * Petit écran : le menu devient une barre d'onglets fixée en bas, à portée de pouce,
   * pictogramme au-dessus du libellé. Le pied de page garde la place de la barre.
   */
  @media (max-width: 47.99rem) {
    /* Le menu part en bas : le logo et « Mon compte » tiennent sur une ligne. */
    .en-tete__interieur {
      flex-wrap: nowrap;
      column-gap: var(--espace-2);
    }

    .compte {
      padding-inline: var(--espace-2);
      font-size: 0.875rem;
      white-space: nowrap;
    }

    .menu {
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 10;
      padding-block-end: env(safe-area-inset-bottom);
      border-block-start: 1px solid var(--couleur-bordure);
      background: var(--couleur-surface);
      box-shadow: 0 -2px 10px rgb(0 0 0 / 8%);
    }

    .menu li {
      flex: 1;
    }

    .menu a {
      flex-direction: column;
      justify-content: center;
      gap: 0.125rem;
      min-height: 3.5rem;
      padding: var(--espace-1) 0.125rem;
      font-size: 0.8125rem;
      line-height: 1.2;
      text-align: center;
    }

    .menu :global(.icone) {
      inline-size: 1.4rem;
      block-size: 1.4rem;
    }

    /* Onglet actif : un trait épais au-dessus, en plus de la couleur. */
    .menu a[aria-current='page'] {
      box-shadow: inset 0 3px 0 currentColor;
    }

    :global(body) {
      padding-block-end: calc(3.5rem + env(safe-area-inset-bottom));
    }
  }

  /* Grand écran : en-tête collé en haut, sur un fond translucide. */
  @media (min-width: 48rem) {
    .en-tete {
      position: sticky;
      inset-block-start: 0;
      z-index: 10;
      background: color-mix(in srgb, var(--couleur-surface) 88%, transparent);
      backdrop-filter: blur(8px);
    }

    .menu {
      flex-wrap: wrap;
      gap: var(--espace-1) var(--espace-2);
    }

    .menu a {
      gap: var(--espace-2);
      min-height: var(--cible-tactile);
      padding-inline: var(--espace-2);
      border-radius: var(--rayon) var(--rayon) 0 0;
    }

    .menu a[aria-current='page'] {
      box-shadow: inset 0 -3px 0 currentColor;
    }

    :global(html) {
      scroll-padding-block-start: 5rem;
    }
  }
</style>
