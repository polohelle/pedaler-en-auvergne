---
import { PAGES_ASSOCIATION } from '@config/association';

interface Props {
  /** Chemin de la page courante, pour signaler l'entrée active. */
  chemin: string;
}

const { chemin } = Astro.props;
---

<nav class="nav-association" aria-label="Pages de l'association">
  <ul class="nav-association__liste">
    {PAGES_ASSOCIATION.map(({ href, libelle }) => (
      <li>
        <a href={href} aria-current={chemin === href ? 'page' : undefined}>
          {libelle}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-association__liste {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    margin: 0 0 var(--espace-4);
    padding: 0;
    list-style: none;
  }

  .nav-association__liste a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-tactile);
    padding-inline: var(--espace-3);
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon);
    color: var(--couleur-texte);
    text-decoration: none;
  }

  .nav-association__liste a:hover {
    text-decoration: underline;
  }

  .nav-association__liste a[aria-current='page'] {
    border-color: var(--couleur-primaire);
    background: var(--couleur-primaire);
    color: var(--couleur-primaire-contraste);
    font-weight: 600;
  }
</style>
