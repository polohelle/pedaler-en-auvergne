---
import type { CollectionEntry } from 'astro:content';
import EtiquettesPratiques from '@components/EtiquettesPratiques.astro';
import EtiquetteType from '@components/EtiquetteType.astro';
import Icone from '@components/Icone.astro';
import IllustrationEvenement from '@components/IllustrationEvenement.astro';
import PastilleDate from '@components/PastilleDate.astro';
import { formaterPlage } from '@lib/dates';

/**
 * Carte d'un événement dans une grille (agenda, accueil, pages par commune) : un bandeau
 * illustré portant la date et les pratiques, puis le titre, la date, le lieu et le type.
 * La couleur du type teinte l'illustration et son étiquette (ADR 0039).
 * Toute la carte mène à la fiche.
 */
interface Props {
  evenement: CollectionEntry<'evenements'>;
  /** Titre de la carte : `h2` seule dans la page, `h3` sous une section. */
  niveau?: 'h2' | 'h3';
}

const { evenement, niveau: Titre = 'h2' } = Astro.props;
const { id, data } = evenement;
const annule = data.statut === 'annule';
---

<li class:list={['evenement', `type-${data.type}`, { 'evenement--annule': annule }]}>
  <div class="evenement__bandeau">
    {data.image ? (
      <img
        class:list={['illustration', 'evenement__photo', { 'illustration--annule': annule }]}
        src={data.image.src}
        alt=""
        width="384"
        height="192"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <IllustrationEvenement type={data.type} annule={annule} />
    )}
    <PastilleDate date={data.debut} />
    <div class="evenement__pratiques">
      <EtiquettesPratiques pratiques={data.pratiques} />
    </div>
  </div>
  <div class="evenement__corps">
    <Titre class:list={['evenement__titre', { annule }]}>
      <a href={`/agenda/${id}/`}>{data.titre}</a>
    </Titre>
    {annule && <p class="etiquette etiquette-annule">Annulé</p>}
    <p class="evenement__info">
      <Icone nom="calendrier" />
      <span class:list={{ annule }}>{formaterPlage(data.debut, data.fin)}</span>
    </p>
    <p class="evenement__info">
      <Icone nom="lieu" />
      <span class:list={{ annule }}>{data.commune}</span>
    </p>
    <p class="evenement__info evenement__pied">
      <EtiquetteType type={data.type} />
      {data.tarif && <span class="discret">{data.tarif}</span>}
    </p>
  </div>
</li>

<style>
  .evenement {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon-grand);
    background: var(--couleur-surface);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .evenement:hover {
    border-color: var(--couleur-type, var(--couleur-primaire));
    box-shadow: 0 0.5rem 1.25rem -0.75rem rgb(0 0 0 / 35%);
    transform: translateY(-2px);
  }

  .evenement:focus-within {
    border-color: var(--couleur-type, var(--couleur-primaire));
  }

  /* Bandeau 2:1 : la photo ou l'illustration du type, avec date et pratiques en surimpression. */
  .evenement__bandeau {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    background: color-mix(in srgb, var(--couleur-type) 14%, var(--couleur-surface));
  }

  .evenement__bandeau > :global(.illustration) {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .evenement__photo {
    object-fit: cover;
    /* Une affiche se reconnaît à son titre, en haut. */
    object-position: top;
  }

  .evenement__photo.illustration--annule {
    filter: grayscale(1);
    opacity: 0.6;
  }

  .evenement__bandeau > :global(.pastille-date) {
    position: absolute;
    inset-block-start: var(--espace-2);
    inset-inline-end: var(--espace-2);
    background: var(--couleur-surface);
    box-shadow: 0 1px 4px rgb(0 0 0 / 20%);
  }

  .evenement__pratiques {
    position: absolute;
    inset-block-start: var(--espace-2);
    inset-inline-start: var(--espace-2);
    max-inline-size: calc(100% - 5.5rem);
  }

  .evenement__pratiques :global(.etiquette) {
    box-shadow: 0 1px 4px rgb(0 0 0 / 20%);
    font-weight: 600;
  }

  .evenement__corps {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--espace-1);
    padding: var(--espace-3);
  }

  .evenement__corps > * {
    margin: 0;
  }

  .evenement__titre {
    margin-block-end: var(--espace-1);
    font-size: 1.2rem;
  }

  .evenement__titre a {
    color: var(--couleur-texte);
    text-decoration: none;
  }

  /* Lien étendu : toute la carte mène à la fiche, sans second lien pour les lecteurs d'écran. */
  .evenement__titre a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .evenement:hover .evenement__titre a,
  .evenement__titre a:focus-visible {
    color: var(--couleur-lien);
    text-decoration: underline;
  }

  .evenement__titre.annule a {
    text-decoration: line-through;
  }

  .etiquette-annule {
    align-self: start;
  }

  .evenement__info {
    display: flex;
    align-items: baseline;
    gap: var(--espace-2);
    line-height: 1.4;
  }

  .evenement__info > :global(.icone) {
    align-self: center;
    color: var(--couleur-primaire);
  }

  /* Le type ferme la carte, sous un filet, comme une légende. */
  .evenement__pied {
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: auto;
    padding-block-start: var(--espace-2);
    border-block-start: 1px solid var(--couleur-bordure);
  }

  .evenement__info:has(+ .evenement__pied) {
    margin-block-end: var(--espace-2);
  }
</style>
