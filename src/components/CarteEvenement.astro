---
import type { CollectionEntry } from 'astro:content';
import { LIBELLES_TYPE_EVENEMENT } from '@config/evenements';
import EtiquettesPratiques from '@components/EtiquettesPratiques.astro';
import IllustrationEvenement from '@components/IllustrationEvenement.astro';
import PastilleDate from '@components/PastilleDate.astro';
import { formaterPlage } from '@lib/dates';

/** Carte d'un événement dans une liste (agenda, pages par commune). */
interface Props {
  evenement: CollectionEntry<'evenements'>;
  /** Titre de la carte : `h2` dans l'agenda, `h3` sous une section. */
  niveau?: 'h2' | 'h3';
}

const { evenement, niveau: Titre = 'h2' } = Astro.props;
const { id, data } = evenement;
const annule = data.statut === 'annule';
---

<li class="carte evenement">
  <PastilleDate date={data.debut} />
  <div class="evenement__corps">
    <Titre class:list={{ annule }}>
      <a href={`/agenda/${id}/`}>{data.titre}</a>
    </Titre>
    {annule && <p class="etiquette etiquette-annule">Annulé</p>}
    <p class:list={{ annule }}>
      {formaterPlage(data.debut, data.fin)} — {data.commune}
    </p>
    <p class="discret">{LIBELLES_TYPE_EVENEMENT[data.type]}</p>
    <EtiquettesPratiques pratiques={data.pratiques} />
  </div>
  <IllustrationEvenement type={data.type} annule={annule} />
</li>

<style>
  .evenement {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--espace-3);
  }

  .evenement__corps {
    min-width: 0;
  }

  /* Sur un petit écran, l'illustration passe sous la pastille pour laisser la place au titre. */
  @media (max-width: 30rem) {
    .evenement {
      grid-template-columns: auto 1fr;
      row-gap: var(--espace-2);
    }

    .evenement > :global(.pastille-date) {
      justify-self: center;
    }

    .evenement > :global(.illustration) {
      grid-area: 2 / 1;
      inline-size: 3.75rem;
      block-size: 2.5rem;
    }

    .evenement__corps {
      grid-row: 1 / span 2;
    }
  }

  .evenement__corps > * {
    margin-block: 0 var(--espace-1);
  }

  .evenement__corps > :last-child {
    margin-block-end: 0;
  }
</style>
