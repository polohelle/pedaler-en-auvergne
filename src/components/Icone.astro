---
import type { TypeEvenement } from '@config/evenements';

/** Pictogramme de chaque type d'événement, dans son étiquette de couleur (ADR 0039). */
const TYPES = {
  sortie:
    'M6 19a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm12 0a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM6 15.5 9.5 9h6l2.5 6.5M9.5 9l2.5 6.5L15.5 9M8 6.5h3m4.5 2.5-1-2.5h2.5',
  randonnee: 'M12 21V3m-7 4h11l3 3-3 3H5Z',
  'social-ride':
    'M4 10h12v4a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5Zm12 1h1.5a2.5 2.5 0 0 1 0 5H16M8 3c-.7 1.2.7 2.3 0 3.5M12 3c-.7 1.2.7 2.3 0 3.5',
  course: 'M5 21V4m0 0h13l-2.5 4.5L18 13H5',
  velorution: 'M4 10v4h3l8 4.5V5.5L7 10H4Zm14-1a3.5 3.5 0 0 1 0 6M7 14l1 5h2.5',
  bourse: 'M17 6.5a6.5 6.5 0 1 0 0 11M4 10.5h9M4 13.5h9',
  'atelier-reparation':
    'M14.5 4.5a5 5 0 0 0-4.3 6.8L4 17.5 6.5 20l6.2-6.2a5 5 0 0 0 6.8-4.3L17 12l-3-1-1-3Z',
  formation: 'm2 9 10-5 10 5-10 5ZM6 11v5c3.5 2.5 8.5 2.5 12 0v-5m4-2v6',
  conference: 'M9 6a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0Zm-4 5a7 7 0 0 0 14 0m-7 7v3m-4 0h8',
  'fete-du-velo': 'm12 3 2.6 5.5 6 .8-4.4 4.1 1.1 6L12 16.5l-5.3 2.9 1.1-6-4.4-4.1 6-.8Z',
  'reunion-publique':
    'M3 6a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-4 3v-3a2 2 0 0 1-2-2Zm16 3h0a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2v3l-4-3h-3a2 2 0 0 1-2-1.5',
} as const satisfies Record<TypeEvenement, string>;

/**
 * Pictogramme au trait, dessin maison sur une grille de 24 : il prend la couleur du texte et
 * reste décoratif, le libellé est toujours écrit à côté. Sa taille suit celle du texte.
 */
const TRACES = {
  calendrier:
    'M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM3 10h18M8 3v4m8-4v4',
  lieu: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  type: 'M3 4v7l9.5 9.5a1.5 1.5 0 0 0 2 0l6-6a1.5 1.5 0 0 0 0-2L11 3H4a1 1 0 0 0-1 1Zm5 4.5h.01',
  annuaire: 'M4 10v10h16V10M3 4h18l-1 6H4L3 4Zm7 16v-5h4v5',
  agenda:
    'M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM3 10h18M8 3v4m8-4v4M8 14h3v3H8Z',
  itineraires:
    'M6 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12-14a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM8 19h8.5a3.5 3.5 0 0 0 0-7h-9a3.5 3.5 0 0 1 0-7H16',
  actus:
    'M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 4h10M7 12h10M7 16h6',
  'a-propos': 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-10v5m0-8h.01',
  fleche: 'M5 12h14m-6-6 6 6-6 6',
  ...TYPES,
} as const;

interface Props {
  nom: keyof typeof TRACES;
}

const { nom } = Astro.props;
---

<svg class="icone" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  <path d={TRACES[nom]}></path>
</svg>

<style>
  .icone {
    flex: none;
    inline-size: 1.15em;
    block-size: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
