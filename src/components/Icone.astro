---
/**
 * Pictogramme au trait, dessin maison sur une grille de 24 : il prend la couleur du texte et
 * reste décoratif, le libellé est toujours écrit à côté. Sa taille suit celle du texte.
 */
const TRACES = {
  calendrier:
    'M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM3 10h18M8 3v4m8-4v4',
  lieu: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  type: 'M3 4v7l9.5 9.5a1.5 1.5 0 0 0 2 0l6-6a1.5 1.5 0 0 0 0-2L11 3H4a1 1 0 0 0-1 1Zm5 4.5h.01',
  annuaire: 'M4 10v10h16V10M3 4h18l-1 6H4L3 4Zm7 16v-5h4v5',
  agenda:
    'M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM3 10h18M8 3v4m8-4v4M8 14h3v3H8Z',
  itineraires:
    'M6 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12-14a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM8 19h8.5a3.5 3.5 0 0 0 0-7h-9a3.5 3.5 0 0 1 0-7H16',
  actus:
    'M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 4h10M7 12h10M7 16h6',
  'a-propos': 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-10v5m0-8h.01',
  fleche: 'M5 12h14m-6-6 6 6-6 6',
  compte: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0',
} as const;

interface Props {
  nom: keyof typeof TRACES;
}

const { nom } = Astro.props;
---

<svg class="icone" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  <path d={TRACES[nom]}></path>
</svg>

<style>
  .icone {
    flex: none;
    inline-size: 1.15em;
    block-size: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
