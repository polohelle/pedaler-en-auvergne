---
/**
 * Tête des pages de liste et des fiches : bandeau pâle avec le titre de niveau 1 (ADR 0024),
 * aux couleurs de la rubrique courante, filet à gauche (ADR 0039). Le contenu glissé
 * s'affiche sous le titre.
 */
interface Props {
  titre: string;
  /** Barre le titre (événement annulé). */
  barre?: boolean;
}

const { titre, barre = false } = Astro.props;
---

<div class="tete-page">
  <h1 class:list={{ annule: barre }}>{titre}</h1>
  <slot />
</div>

<style>
  .tete-page {
    margin-block: var(--espace-3) var(--espace-4);
    padding: var(--espace-3);
    border-inline-start: 0.375rem solid var(--couleur-rubrique);
    border-radius: var(--rayon-grand);
    background: var(--couleur-rubrique-pale);
  }

  .tete-page h1 {
    margin-block-start: 0;
  }

  .tete-page > :global(:last-child) {
    margin-block-end: 0;
  }

  .tete-page :global(p:not(.etiquette)) {
    color: var(--couleur-texte-doux);
  }
</style>
