---
import { ASSOCIATION } from '@config/association';
---

{ASSOCIATION.statutsAdoptesLe === null && (
  <aside class="avis-provisoire" aria-label="Textes provisoires">
    <p>
      <strong>Association en cours de création.</strong> Les textes de cette rubrique reprennent le
      projet de statuts et de charte : ils seront soumis à l'assemblée constitutive et peuvent
      encore changer.
    </p>
  </aside>
)}

<style>
  .avis-provisoire {
    max-width: var(--largeur-texte);
    margin-block-end: var(--espace-4);
    padding: var(--espace-3);
    border-inline-start: 4px solid var(--couleur-focus);
    border-radius: var(--rayon);
    background: var(--couleur-fond-doux);
  }

  .avis-provisoire p {
    margin: 0;
  }
</style>
