---
import { SITE } from '@config/site';
import Logo from '@components/Logo.astro';

const annee = new Date().getFullYear();
---

<footer class="pied">
  <svg
    class="pied__relief"
    viewBox="0 0 320 24"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0 24V16c30-4 50-9 80-8s50 8 80 5 50-10 80-9 50 6 80 8v12Z"></path>
  </svg>
  <div class="conteneur pied__interieur">
    <a class="pied__marque" href="/">
      <Logo />
    </a>
    <nav aria-label="Liens de pied de page">
      <ul class="liste-simple pied__liens">
        <li>
          <a href="/communes/">Le vélo par commune</a>
        </li>
        <li>
          <a href="/a-propos/">À propos et contact</a>
        </li>
        <li>
          <a href="/mentions-legales/">Mentions légales et confidentialité</a>
        </li>
        <li>
          <a href={SITE.depot}>Code source</a>
        </li>
      </ul>
    </nav>
    <p class="discret">
      Code sous licence <a href={`${SITE.depot}/blob/main/LICENSE`}>MIT</a>, textes sous licence{' '}
      <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr" hreflang="fr">
        CC BY-SA 4.0
      </a>
      , données de l'annuaire sous licence{' '}
      <a href="https://opendatacommons.org/licenses/odbl/1-0/" hreflang="en">
        ODbL 1.0
      </a>
      , dont une partie ©{' '}
      <a href="https://www.openstreetmap.org/copyright">contributeurs OpenStreetMap</a>. Le nom et
      le logo {SITE.nom} ne sont pas sous licence libre.{' '}
      <a href={`${SITE.depot}/blob/main/LICENSES.md`}>Détail des licences</a>.
    </p>
    <p class="discret">
      © {annee} {SITE.nom}
    </p>
  </div>
</footer>

<style>
  .pied {
    margin-block-start: var(--espace-5);
    background: var(--couleur-prairie-pale);
  }

  /* Les collines du bandeau d'accueil, en écho, sur le bord haut du pied de page. */
  .pied__relief {
    display: block;
    width: 100%;
    height: 1.5rem;
    background: var(--couleur-fond);
    fill: var(--couleur-colline);
  }

  .pied__interieur {
    padding-block: var(--espace-4);
  }

  .pied__marque {
    display: inline-flex;
    min-height: var(--cible-tactile);
    margin-block-end: var(--espace-3);
    color: var(--couleur-texte);
    text-decoration: none;
  }

  .pied__liens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-1) var(--espace-4);
  }

  .pied__liens a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-tactile);
  }

  .pied .discret a {
    color: inherit;
  }
</style>
