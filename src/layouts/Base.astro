---
import policeTitres from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import policeTexte from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import '../styles/polices.css';
import '../styles/tokens.css';
import '../styles/base.css';
import EnTete from '@components/EnTete.astro';
import LienEvitement from '@components/LienEvitement.astro';
import PiedDePage from '@components/PiedDePage.astro';
import { SITE } from '@config/site';
import { serialiserJsonLd, type DonneesStructurees } from '@lib/donnees-structurees';
import { estIndexable, urlAbsolue } from '@lib/referencement';
import { rubriqueDe } from '@lib/rubriques';

interface Props {
  /** Titre propre à la page ; le nom du site est ajouté automatiquement. */
  titre: string;
  description?: string;
  /** Image de partage (affiche, photo, logo) ; à défaut, l'icône du site. */
  image?: string | undefined;
  /** `article` pour une actualité, `website` sinon (Open Graph). */
  typeOg?: 'website' | 'article';
  /** Données structurées schema.org de la page (src/lib/donnees-structurees.ts). */
  donnees?: DonneesStructurees | undefined;
}

const { titre, description = SITE.description, image, typeOg = 'website', donnees } = Astro.props;
const titreComplet =
  Astro.url.pathname === '/' ? `${SITE.nom} — ${SITE.slogan}` : `${titre} — ${SITE.nom}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const indexable = estIndexable(Astro.url.pathname);
const imagePartage = urlAbsolue(image ?? SITE.imagePartage, canonique);
const rubrique = rubriqueDe(Astro.url.pathname);
---

<!doctype html>
<html lang={SITE.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="preload" href={policeTitres} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={policeTexte} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content={SITE.couleurTheme} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Actualités — ${SITE.nom}`}
      href="/actus/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Agenda — ${SITE.nom}`}
      href="/agenda/rss.xml"
    />
    <meta property="og:type" content={typeOg} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imagePartage} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {donnees && (
      <script is:inline type="application/ld+json" set:html={serialiserJsonLd(donnees)} />
    )}
    <script is:inline src="/registerSW.js" defer></script>
  </head>
  <body data-rubrique={rubrique}>
    <LienEvitement />
    <EnTete chemin={Astro.url.pathname} />
    <main id="contenu" class="conteneur" tabindex="-1">
      <slot />
    </main>
    <PiedDePage />
  </body>
</html>
