---
import { COLLEGES, LIBELLES_COLLEGE } from '@config/acteurs';
import { ASSOCIATION } from '@config/association';
import { SITE } from '@config/site';
import Base from '@layouts/Base.astro';
import { acteursPublies } from '@services/contenus';

const membres = (await acteursPublies()).filter((a) => a.data.membre);
const descriptions: Record<(typeof COLLEGES)[number], string> = {
  'commerce-reparation': 'Magasins, réparateurs, loueurs.',
  'entreprises-a-velo': 'Livreurs, cyclologistique, artisans, tourisme.',
  usagers: "Associations d'usagers, ateliers participatifs, vélo-écoles.",
  'sport-loisir': 'Clubs, comités, cyclotourisme, VTT.',
  partenaires: 'Collectivités, écoles, experts, avec voix consultative.',
};
---

<Base
  titre="L'association"
  description="Pédaler en Auvergne fédère les acteurs du vélo du Puy-de-Dôme, organisés en collèges."
>
  <h1>L'association</h1>
  <p class="texte">
    {ASSOCIATION.nom} fédère tous les acteurs du vélo du Puy-de-Dôme, avant une extension à
    l'Auvergne. Elle donne une voix commune à la filière vélo locale auprès des collectivités, du
    public et de la presse.
  </p>

  <h2>Gouvernance par collèges</h2>
  <ul class="grille liste-simple">
    {COLLEGES.map((college) => {
      const duCollege = membres.filter((m) => m.data.college === college);
      return (
        <li class="carte">
          <h3>{LIBELLES_COLLEGE[college]}</h3>
          <p>{descriptions[college]}</p>
          {duCollege.length > 0 && (
            <ul>
              {duCollege.map(({ id, data }) => (
                <li>
                  <a href={`/annuaire/${id}/`}>{data.nom}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })}
  </ul>

  <h2>Adhérer et soutenir</h2>
  {SITE.adhesionUrl === null ? (
    <p class="texte">
      L'adhésion et les dons passeront par HelloAsso dès la déclaration de l'association.
    </p>
  ) : (
    <a class="bouton" href={SITE.adhesionUrl}>
      Adhérer sur HelloAsso
    </a>
  )}

  <h2>Contact</h2>
  {ASSOCIATION.email === null ? (
    <p class="texte">L'adresse de contact sera publiée à la déclaration de l'association.</p>
  ) : (
    <p>
      <a href={`mailto:${ASSOCIATION.email}`}>{ASSOCIATION.email}</a>
    </p>
  )}
</Base>
