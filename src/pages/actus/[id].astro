---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { LIBELLES_CATEGORIE_ACTU, LIBELLES_PORTEE, LIBELLES_TYPE_ACTU } from '@config/actus';
import TetePage from '@components/TetePage.astro';
import Base from '@layouts/Base.astro';
import { formaterDate } from '@lib/dates';
import { donneesActu } from '@lib/donnees-structurees';
import { urlAbsolue } from '@lib/referencement';
import { SITE } from '@config/site';
import { actusPubliees } from '@services/contenus';

export const getStaticPaths = (async () => {
  const actus = await actusPubliees();
  return actus.map((actu) => ({ params: { id: actu.id }, props: { actu } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { actu } = Astro.props;
const { data } = actu;
const { Content } = await render(actu);
const url = urlAbsolue(Astro.url.pathname, Astro.site ?? Astro.url);
const image = data.image && urlAbsolue(data.image.src, url);
const donnees = donneesActu(
  data,
  { url, image },
  { nom: SITE.nom, url: urlAbsolue('/', url), logo: urlAbsolue(SITE.imagePartage, url) },
);
---

<Base titre={data.titre} description={data.resume} {image} typeOg="article" {donnees}>
  <article>
    <TetePage titre={data.titre}>
      <p>
        {LIBELLES_TYPE_ACTU[data.type]} · {LIBELLES_PORTEE[data.portee]} ·{' '}
        <time datetime={data.date}>{formaterDate(new Date(`${data.date}T12:00:00Z`))}</time> ·{' '}
        {data.categories.map((c) => LIBELLES_CATEGORIE_ACTU[c]).join(', ')}
      </p>
    </TetePage>
    <p class="texte">
      <strong>{data.resume}</strong>
    </p>
    {data.image && (
      <figure>
        <img class="photo" src={data.image.src} alt={data.image.alt} decoding="async" />
        <figcaption class="discret">Photo : {data.image.credit}</figcaption>
      </figure>
    )}
    <div class="texte">
      <Content />
    </div>
    {data.source_url && (
      <p class="discret">
        Source : <a href={data.source_url}>{data.source_nom}</a>
      </p>
    )}
  </article>
</Base>

<style>
  figure {
    margin: 0 0 var(--espace-4);
  }

  .photo {
    display: block;
    width: 100%;
    max-width: 48rem;
    height: auto;
    border-radius: var(--rayon);
  }

  figcaption {
    margin-block-start: var(--espace-1);
  }
</style>
