---
import CarteActu from '@components/CarteActu.astro';
import TetePage from '@components/TetePage.astro';
import Base from '@layouts/Base.astro';
import { actusPubliees } from '@services/contenus';

const actus = await actusPubliees();
---

<Base
  titre="Actualités du vélo"
  description="Actualités du vélo local et national utiles aux acteurs du Puy-de-Dôme."
>
  <TetePage titre="Actualités du vélo">
    <p class="texte">
      Aménagements, sport, politique vélo et filière : ce qui bouge près de chez vous et ce qui
      change au niveau national.
    </p>
  </TetePage>
  {actus.length === 0 ? (
    <p class="texte">Aucune actualité publiée pour le moment.</p>
  ) : (
    <ul class="liste-simple">
      {actus.map((actu) => (
        <CarteActu actu={actu} />
      ))}
    </ul>
  )}
  <p class="discret">
    <a href="/actus/rss.xml">Suivre les actualités par flux RSS</a>
  </p>
</Base>
