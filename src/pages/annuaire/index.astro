---
import { LIBELLES_CATEGORIE_ASSOCIATIVE } from '@config/acteurs';
import { SITE } from '@config/site';
import Appel from '@components/Appel.astro';
import CarteActeur from '@components/CarteActeur.astro';
import CarteAnnuaire from '@components/CarteAnnuaire.astro';
import TetePage from '@components/TetePage.astro';
import Base from '@layouts/Base.astro';
import { sectionsAnnuaire } from '@lib/annuaire';
import { acteursPublies } from '@services/contenus';

const acteurs = await acteursPublies();
const { commerces, associations, nombreAssociations } = sectionsAnnuaire(
  acteurs,
  (a) => a.data.categories,
);
---

<Base
  titre="Annuaire des acteurs du vélo"
  description="Magasins, réparateurs, loueurs, ateliers, vélo-écoles, associations et clubs du Puy-de-Dôme."
>
  <TetePage titre="Annuaire des acteurs du vélo">
    <p class="texte">
      Magasins et réparateurs, loueurs, ateliers participatifs, vélo-écoles, associations et clubs
      du Puy-de-Dôme.
    </p>
  </TetePage>
  {acteurs.length === 0 ? (
    <p class="texte">
      L'annuaire est en cours de constitution : les premières fiches seront publiées après
      vérification.
    </p>
  ) : (
    <>
      <nav class="sections rubrique-annuaire" aria-label="Sections de l'annuaire">
        <ul class="sections__liste">
          <li>
            <a href="#commerces-et-services">
              Commerces et services <span class="sections__nombre">{commerces.length}</span>
            </a>
          </li>
          <li>
            <a href="#associations-et-clubs">
              Associations et clubs <span class="sections__nombre">{nombreAssociations}</span>
            </a>
          </li>
          {associations.map(({ categorie, acteurs: groupe }) => (
            <li class="sections__sous">
              <a href={`#${categorie}`}>
                {LIBELLES_CATEGORIE_ASSOCIATIVE[categorie]}{' '}
                <span class="sections__nombre">{groupe.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <CarteAnnuaire />
      <p class="discret">{acteurs.length} acteur(s) référencé(s).</p>
      <h2 id="commerces-et-services">Commerces et services</h2>
      <ul class="grille liste-simple">
        {commerces.map((acteur) => (
          <CarteActeur acteur={acteur} niveau="h3" />
        ))}
      </ul>
      <h2 id="associations-et-clubs">Associations et clubs</h2>
      <p class="texte">
        Clubs sportifs (FFC, FFVélo…), associations d'usagers, ateliers participatifs et
        vélo-écoles. Les clubs n'ont pas d'adresse d'accueil publique : contactez-les par leur site.
      </p>
      {associations.map(({ categorie, acteurs: groupe }) => (
        <section aria-labelledby={categorie}>
          <h3 id={categorie}>{LIBELLES_CATEGORIE_ASSOCIATIVE[categorie]}</h3>
          <ul class="grille liste-simple">
            {groupe.map((acteur) => (
              <CarteActeur acteur={acteur} niveau="h4" />
            ))}
          </ul>
        </section>
      ))}
    </>
  )}
  <Appel
    titre="Votre structure n'y est pas ?"
    lien={`${SITE.depot}/issues/new?template=2-referencer-structure.yml`}
    libelle="Référencer ma structure"
  >
    L'annuaire est gratuit et ouvert à tous les acteurs du vélo du territoire, adhérents ou non.
  </Appel>
  <p>
    <a href="/communes/">Voir l'annuaire commune par commune</a>
  </p>
  <p class="discret">
    Une partie des données de l'annuaire provient d'OpenStreetMap, ©{' '}
    <a href="https://www.openstreetmap.org/copyright">contributeurs OpenStreetMap</a>, licence ODbL.
  </p>
</Base>

<style>
  /* Sections en boutons sur une ligne, à la manière des onglets du menu principal. */
  .sections__liste {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    margin: 0 0 var(--espace-4);
    padding: 0;
    list-style: none;
  }

  .sections a {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--cible-tactile);
    padding-inline: var(--espace-3);
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon);
    background: var(--couleur-surface);
    color: var(--couleur-texte);
    font-size: var(--taille-petite);
    font-weight: 600;
    text-decoration: none;
  }

  /* Sous-catégories des associations : même bouton, trait plus léger. */
  .sections__sous a {
    font-weight: 400;
  }

  .sections a:hover {
    border-color: var(--couleur-rubrique);
    background: var(--couleur-rubrique-pale);
    color: var(--couleur-rubrique);
    box-shadow: inset 0 -3px 0 currentColor;
  }

  .sections__nombre {
    min-width: 1.75rem;
    padding: 0 var(--espace-2);
    border-radius: 999px;
    background: var(--couleur-rubrique-pale);
    color: var(--couleur-texte);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
  }

  .sections a:hover .sections__nombre {
    background: var(--couleur-surface);
  }

  @media (max-width: 47.99rem) {
    .sections a {
      padding-inline: var(--espace-2);
    }
  }
</style>
