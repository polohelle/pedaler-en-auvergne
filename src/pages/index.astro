---
import { SITE } from '@config/site';
import Base from '@layouts/Base.astro';
import { formaterDate, formaterPlage } from '@lib/dates';
import { actusPubliees, evenementsAVenir } from '@services/contenus';

const prochains = (await evenementsAVenir()).slice(0, 3);
const dernieres = (await actusPubliees()).slice(0, 3);
---

<Base titre="Accueil">
  <section class="bandeau" aria-labelledby="titre-accueil">
    <h1 id="titre-accueil">{SITE.nom}</h1>
    <p class="texte">
      {SITE.slogan} du Puy-de-Dôme, puis de toute l'Auvergne : magasins et réparateurs, ateliers
      participatifs, vélo-écoles, associations, clubs et entreprises à vélo, réunis en un seul
      endroit.
    </p>
    <svg
      class="bandeau__relief"
      viewBox="0 0 320 46"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M0 46V36l40-6c18-20 30-26 40-26l8 6 8-6c16 6 26 20 36 30 12-8 22-12 32-10 12 2 20 10 28 14l40-4c14-10 26-14 38-12 14 2 24 10 50 14v10Z"></path>
    </svg>
  </section>

  <ul class="grille liste-simple">
    <li class="carte">
      <h2>
        <a href="/annuaire/">Trouver un acteur du vélo</a>
      </h2>
      <p>Réparateur, loueur, atelier, club ou vélo-école près de chez vous.</p>
    </li>
    <li class="carte">
      <h2>
        <a href="/agenda/">Agenda</a>
      </h2>
      <p>Sorties, bourses aux vélos, ateliers, courses et fêtes du vélo.</p>
    </li>
    <li class="carte">
      <h2>
        <a href="/actus/">Actualités</a>
      </h2>
      <p>Les nouvelles du vélo local et ce qui change au niveau national.</p>
    </li>
  </ul>

  {prochains.length > 0 && (
    <section aria-labelledby="titre-prochains">
      <h2 id="titre-prochains">Prochains événements</h2>
      <ul class="liste-simple">
        {prochains.map(({ id, data }) => (
          <li>
            <a href={`/agenda/${id}/`}>{data.titre}</a>
            <span class="discret">
              {' '}
              — {formaterPlage(data.debut, data.fin)}, {data.commune}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {dernieres.length > 0 && (
    <section aria-labelledby="titre-actus">
      <h2 id="titre-actus">Dernières actualités</h2>
      <ul class="liste-simple">
        {dernieres.map(({ id, data }) => (
          <li>
            <a href={`/actus/${id}/`}>{data.titre}</a>
            <span class="discret"> — {formaterDate(new Date(`${data.date}T12:00:00Z`))}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="titre-rejoindre">
    <h2 id="titre-rejoindre">Rejoindre le réseau</h2>
    <p class="texte">
      Vous êtes un acteur du vélo ? Rejoignez l'association pour donner du poids à la filière vélo
      locale.
    </p>
    <a class="bouton" href="/association/">
      Découvrir l'association
    </a>
  </section>
</Base>

<style>
  /* Bandeau basalte bordé par le relief des Puys (ADR 0024). */
  .bandeau {
    margin-block: var(--espace-3) var(--espace-4);
    padding: var(--espace-2) var(--espace-3) 0;
    border-radius: var(--rayon-grand);
    overflow: hidden;
    background: var(--couleur-entete-fond);
    color: var(--couleur-entete-texte);
  }

  .bandeau p {
    color: var(--couleur-entete-texte-doux);
  }

  .bandeau__relief {
    display: block;
    width: calc(100% + 2 * var(--espace-3));
    height: 2.75rem;
    margin-inline: calc(-1 * var(--espace-3));
    fill: var(--couleur-fond);
  }
</style>
