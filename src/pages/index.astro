---
import CarteActu from '@components/CarteActu.astro';
import CarteEvenement from '@components/CarteEvenement.astro';
import Icone from '@components/Icone.astro';
import { SITE } from '@config/site';
import Base from '@layouts/Base.astro';
import { donneesSite } from '@lib/donnees-structurees';
import { urlAbsolue } from '@lib/referencement';
import { actusPubliees, evenementsAVenir } from '@services/contenus';

const prochains = (await evenementsAVenir()).slice(0, 3);
const dernieres = (await actusPubliees()).slice(0, 3);

/** Une tuile par rubrique, à sa couleur (ADR 0039). */
const tuiles = [
  {
    rubrique: 'annuaire',
    titre: 'Trouver un acteur du vélo',
    texte: 'Réparateur, loueur, atelier, club ou vélo-école près de chez vous.',
  },
  {
    rubrique: 'agenda',
    titre: 'Agenda',
    texte: 'Sorties, social rides, vélorutions, bourses aux vélos, ateliers et courses.',
  },
  {
    rubrique: 'itineraires',
    titre: 'Itinéraires',
    texte: 'Parcours route, gravel et VTT du secteur, avec leur trace GPX.',
  },
  {
    rubrique: 'actus',
    titre: 'Actualités',
    texte: 'Les nouvelles du vélo local et ce qui change au niveau national.',
  },
] as const;

const donnees = donneesSite({ ...SITE, url: urlAbsolue('/', Astro.site ?? Astro.url) });
---

<Base titre="Accueil" {donnees}>
  <section class="bandeau" aria-labelledby="titre-accueil">
    <h1 id="titre-accueil">{SITE.nom}</h1>
    <p class="texte">
      {SITE.slogan} du Puy-de-Dôme, puis de toute l'Auvergne : magasins et réparateurs, ateliers
      participatifs, vélo-écoles, associations, clubs et entreprises à vélo, réunis en un seul
      endroit.
    </p>
    <svg
      class="bandeau__relief"
      viewBox="0 0 320 60"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        class="bandeau__collines"
        d="M0 60V40c30-6 50-14 80-12s50 12 80 8 50-16 80-14 50 10 80 12v26Z"
      ></path>
      <path
        class="bandeau__puys"
        d="M0 60V46l40-6c18-20 30-26 40-26l8 6 8-6c16 6 26 20 36 30 12-8 22-12 32-10 12 2 20 10 28 14l40-4c14-10 26-14 38-12 14 2 24 10 50 14v14Z"
      ></path>
      <circle class="bandeau__cycliste" cx="70" cy="21" r="4.5"></circle>
    </svg>
  </section>

  <ul class="grille liste-simple tuiles">
    {tuiles.map(({ rubrique, titre, texte }) => (
      <li class:list={['carte', 'tuile', `rubrique-${rubrique}`]}>
        <h2>
          <a href={`/${rubrique}/`}>
            <span class="tuile__picto">
              <Icone nom={rubrique} />
            </span>
            {titre}
          </a>
        </h2>
        <p>{texte}</p>
      </li>
    ))}
  </ul>

  {prochains.length > 0 && (
    <section class="rubrique-agenda" aria-labelledby="titre-prochains">
      <div class="tete-section">
        <h2 class="titre-rubrique" id="titre-prochains">
          <Icone nom="agenda" />
          Prochains événements
        </h2>
        <a class="lien-fleche" href="/agenda/">
          Tout l'agenda
          <Icone nom="fleche" />
        </a>
      </div>
      <ul class="liste-simple grille-evenements">
        {prochains.map((evenement) => (
          <CarteEvenement evenement={evenement} niveau="h3" />
        ))}
      </ul>
    </section>
  )}

  {dernieres.length > 0 && (
    <section class="rubrique-actus" aria-labelledby="titre-actus">
      <h2 class="titre-rubrique" id="titre-actus">
        <Icone nom="actus" />
        Dernières actualités
      </h2>
      <ul class="liste-simple">
        {dernieres.map((actu) => (
          <CarteActu actu={actu} niveau="h3" avecResume={false} />
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="titre-rejoindre">
    <h2 id="titre-rejoindre">Vous êtes un acteur du vélo ?</h2>
    <p class="texte">
      L'annuaire et l'agenda sont gratuits et ouverts à tous. Proposez vos événements, ou
      <a href="/a-propos/#contact">écrivez</a> pour faire connaître votre structure.
    </p>
    <a class="bouton" href="/agenda/proposer/">
      Proposer un événement
    </a>
  </section>
</Base>

<style>
  /* Tuiles des rubriques : filet, pictogramme et titre à la couleur de la rubrique. */
  .tuiles {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .tuile {
    margin-block-end: 0;
    border-block-start: 0.375rem solid var(--couleur-rubrique);
  }

  .tuile a {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    color: var(--couleur-rubrique);
  }

  .tuile__picto {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    background: var(--couleur-rubrique-pale);
  }

  .titre-rubrique {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
  }

  .titre-rubrique > :global(.icone) {
    color: var(--couleur-rubrique);
  }

  /* Bandeau « Prairie » : vert pâle, posé sur le relief des Puys (ADR 0024). */
  .bandeau {
    margin-block: var(--espace-3) var(--espace-4);
    padding: var(--espace-3) var(--espace-3) 0;
    border-radius: var(--rayon-grand);
    overflow: hidden;
    background: var(--couleur-prairie-pale);
  }

  .bandeau p {
    color: var(--couleur-texte-doux);
  }

  .bandeau__relief {
    display: block;
    width: calc(100% + 2 * var(--espace-3));
    height: 3.25rem;
    margin-inline: calc(-1 * var(--espace-3));
  }

  .bandeau__collines {
    fill: var(--couleur-colline);
  }

  .bandeau__puys {
    fill: var(--couleur-primaire);
  }

  .bandeau__cycliste {
    fill: var(--couleur-genet);
    stroke: var(--couleur-texte);
    stroke-width: 1.5;
  }
</style>
