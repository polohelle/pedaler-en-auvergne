---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { LIBELLES_TYPE_EVENEMENT } from '@config/evenements';
import EtiquettesPratiques from '@components/EtiquettesPratiques.astro';
import IllustrationEvenement from '@components/IllustrationEvenement.astro';
import PastilleDate from '@components/PastilleDate.astro';
import TetePage from '@components/TetePage.astro';
import Vignette from '@components/Vignette.astro';
import Base from '@layouts/Base.astro';
import { formaterPlage } from '@lib/dates';
import { acteursPublies, evenementsVisibles } from '@services/contenus';

export const getStaticPaths = (async () => {
  const evenements = await evenementsVisibles();
  return evenements.map((evenement) => ({ params: { id: evenement.id }, props: { evenement } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { evenement } = Astro.props;
const { data } = evenement;
const { Content } = await render(evenement);
const organisateur = (await acteursPublies()).find((a) => a.id === data.organisateur);
const annule = data.statut === 'annule';
---

<Base
  titre={data.titre}
  description={`${data.titre}, ${formaterPlage(data.debut, data.fin)}, ${data.commune}.`}
>
  <article>
    <div class="tete-evenement">
      <PastilleDate date={data.debut} />
      <TetePage titre={data.titre} barre={annule}>
        <p>
          {LIBELLES_TYPE_EVENEMENT[data.type]} à {data.commune}
        </p>
        <EtiquettesPratiques pratiques={data.pratiques} />
        {annule && <p class="etiquette etiquette-annule">Événement annulé</p>}
      </TetePage>
    </div>
    <IllustrationEvenement type={data.type} taille="grande" annule={annule} />
    <dl class="details">
      <dt>Type</dt>
      <dd>{LIBELLES_TYPE_EVENEMENT[data.type]}</dd>
      <dt>Date</dt>
      <dd class:list={{ annule }}>{formaterPlage(data.debut, data.fin)}</dd>
      <dt>Lieu</dt>
      <dd>
        {data.lieu}, {data.commune}
      </dd>
      {organisateur && (
        <>
          <dt>Organisateur</dt>
          <dd class="organisateur">
            <Vignette acteur={organisateur} />
            <a href={`/annuaire/${organisateur.id}/`}>{organisateur.data.nom}</a>
          </dd>
        </>
      )}
      {data.tarif && (
        <>
          <dt>Tarif</dt>
          <dd>{data.tarif}</dd>
        </>
      )}
      {data.inscription_url && (
        <>
          <dt>Inscription</dt>
          <dd>
            <a href={data.inscription_url}>S'inscrire</a>
          </dd>
        </>
      )}
    </dl>
    <div class="texte">
      <Content />
    </div>
    {!annule && (
      <p>
        <a class="bouton" href={`/agenda/${evenement.id}.ics`} download>
          Ajouter à mon calendrier
        </a>
      </p>
    )}
    <p class="discret">
      Source : <a href={data.source_url}>{new URL(data.source_url).hostname}</a>
    </p>
  </article>
</Base>

<style>
  .organisateur {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
  }

  article > :global(.illustration) {
    margin-block-end: var(--espace-4);
  }

  .tete-evenement {
    display: flex;
    align-items: flex-start;
    gap: var(--espace-3);
    margin-block: var(--espace-3) var(--espace-4);
  }

  .tete-evenement > :global(.tete-page) {
    flex: 1;
    min-width: 0;
    margin: 0;
  }

  .tete-evenement > :global(.pastille-date) {
    border: 2px solid var(--couleur-prairie-pale);
    background: var(--couleur-surface);
  }
</style>
