---
import { FORMULAIRES } from '@config/formulaires';
import { ORGANISATEUR } from '@config/organisateur';
import Appel from '@components/Appel.astro';
import CarteEvenement from '@components/CarteEvenement.astro';
import TetePage from '@components/TetePage.astro';
import Base from '@layouts/Base.astro';
import { grouperParMois } from '@lib/dates';
import { evenementsAVenir } from '@services/contenus';

const evenements = await evenementsAVenir();
const mois = grouperParMois(evenements, ({ data }) => data.debut);
---

<Base
  titre="Agenda des manifestations vélo"
  description="Sorties, bourses aux vélos, ateliers de réparation, courses et fêtes du vélo dans le Puy-de-Dôme."
>
  <TetePage titre="Agenda des manifestations vélo">
    <p class="texte">
      Sorties, bourses aux vélos, ateliers de réparation, courses et fêtes du vélo près de chez
      vous.
    </p>
  </TetePage>
  {evenements.length === 0 ? (
    <p class="texte">Aucun événement à venir pour le moment.</p>
  ) : (
    mois.map(({ cle, libelle, elements }) => (
      <section class="mois" aria-labelledby={`mois-${cle}`}>
        <h2 id={`mois-${cle}`}>
          {libelle}
          <span class="mois__compte discret">
            {elements.length} {elements.length > 1 ? 'événements' : 'événement'}
          </span>
        </h2>
        <ul class="liste-simple grille-evenements">
          {elements.map((evenement) => (
            <CarteEvenement evenement={evenement} niveau="h3" />
          ))}
        </ul>
      </section>
    ))
  )}
  <section class="abonnement" aria-labelledby="titre-abonnement">
    <h2 id="titre-abonnement">Suivre l'agenda</h2>
    <p class="texte">
      Abonnez votre téléphone ou votre agenda en ligne : les nouveaux événements s'y ajoutent
      d'eux-mêmes.
    </p>
    <ul class="liste-simple liens-abonnement">
      <li>
        <a class="bouton" href="/agenda.ics">
          S'abonner au calendrier (iCal)
        </a>
      </li>
      <li>
        <a href="/agenda/rss.xml">Flux RSS de l'agenda</a>
      </li>
    </ul>
  </section>
  <Appel
    titre="Vous organisez une sortie ?"
    lien={FORMULAIRES.pageEvenement}
    libelle="Proposer un événement"
  >
    Bourse, balade, atelier ou course : signalez-le, nous l'ajoutons à l'agenda après vérification.
    Vous en organisez souvent ?{' '}
    <a href={ORGANISATEUR.pages.connexion}>Ouvrez votre espace organisateur</a> pour gérer vos
    événements et leurs dates.
  </Appel>
</Base>

<style>
  .mois h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--espace-3);
  }

  .mois__compte {
    font-family: var(--police);
    font-weight: 400;
  }

  .abonnement {
    margin-block-start: var(--espace-5);
  }

  .liens-abonnement {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espace-3);
  }
</style>
